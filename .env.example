# SubtitleStudio API keys — copy this file to ".env" and fill in your keys.
# The .env file is loaded ONLY in the Electron main process and is git-ignored.
# Keys are never exposed to the renderer.

# Google Gemini (https://ai.google.dev) — primary translation provider.
# A single key powers both gemini-2.5-flash-lite and gemini-2.5-flash.
#
# KEY ROTATION: supply several keys separated by commas to multiply the free
# daily quota. When one key hits its per-day limit the app rotates to the next
# automatically (state resets at the UTC day flip). Example:
#   GEMINI_API_KEY=key_one,key_two,key_three
GEMINI_API_KEY=

# Groq (https://console.groq.com) — fast fallback provider (LLaMA models).
# Also supports comma-separated key rotation, e.g. GROQ_API_KEY=k1,k2
GROQ_API_KEY=

# TMDB (https://www.themoviedb.org/settings/api) — OPTIONAL.
# Enhances movie / live-action metadata. The app works fully without it
# using AniList, Jikan, TVMaze and Wikidata (all key-free).
TMDB_API_KEY=
